# ---------------------------------------------------------------------------
# Kasi Digital Hub - environment template
# Copy to .env (scripts/setup.sh does this) and never commit .env.
# Values below suit the Docker development stack (docker compose up).
# ---------------------------------------------------------------------------

APP_NAME=KasiHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Interface language and demo-data locale (en_ZA = South African names/formats).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Build information shown on /version (set by CI/deploy).
GIT_COMMIT=local
BUILD_TIME=

# --- Platform (config/kasi.php) -------------------------------------------
KASI_BRAND_NAME=KasiHub
KASI_BRAND_FULL_NAME="Kasi Digital Hub"
# Demo mode: demo banner, role switcher, kasi:demo:reset. NEVER true in production.
KASI_DEMO_MODE=true
# Comma-separated module names to switch off, e.g. Connect,Partner
KASI_MODULES_DISABLED=
# External service drivers. Demo/fake drivers cost nothing and call no provider.
KASI_AI_DRIVER=fake
KASI_SMS_DRIVER=log
KASI_WHATSAPP_DRIVER=log
KASI_PAYMENTS_DRIVER=fake
KASI_SEARCH_DRIVER=database
KASI_PDF_DRIVER=fake
# KASI_AI_DRIVER=anthropic and ANTHROPIC_API_KEY=... (or openai + OPENAI_API_KEY) for real AI
# MEILISEARCH_HOST=http://meilisearch:7700 and GOTENBERG_URL=http://gotenberg:3000 with the Compose services

# --- Logging ---------------------------------------------------------------
# Use LOG_STACK=json in production for structured logs.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8.4 in Docker) ---------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kasi
DB_USERNAME=kasi
DB_PASSWORD=secret

# --- Cache, sessions, queues (Redis) ---------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Search (Meilisearch, used from Sprint 8) ------------------------------
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey-local-only

# --- Mail (Mailpit catches all mail locally: http://localhost:8025) --------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@kasidigitalhub.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# --- Server-side rendering (public pages; enable in production) -----------
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
