{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --ssr",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write \"resources/js/**/*.{ts,tsx}\" \"modules/*/resources/js/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"resources/js/**/*.{ts,tsx}\" \"modules/*/resources/js/**/*.{ts,tsx}\"",
        "test": "vitest run",
        "size": "node scripts/check-bundle-size.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.3",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.2",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.0.0",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "@inertiajs/react": "^3.8.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "name": "kasi-digital-hub"
}
