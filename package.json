{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --ssr",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write \"resources/js/**/*.{ts,tsx}\" \"modules/*/resources/js/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"resources/js/**/*.{ts,tsx}\" \"modules/*/resources/js/**/*.{ts,tsx}\"",
        "test": "vitest run",
        "size": "node scripts/check-bundle-size.mjs",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.3",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.2",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.0.0",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "@fontsource/poppins": "^5.3.0",
        "@inertiajs/react": "^3.8.0",
        "@radix-ui/react-checkbox": "^1.3.12",
        "@radix-ui/react-dialog": "^1.2.0",
        "@radix-ui/react-dropdown-menu": "^2.1.25",
        "@radix-ui/react-popover": "^1.2.0",
        "@radix-ui/react-radio-group": "^1.4.8",
        "@radix-ui/react-switch": "^1.3.8",
        "@radix-ui/react-tabs": "^1.1.22",
        "@radix-ui/react-tooltip": "^1.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.52.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwind-merge": "^3.7.0"
    },
    "name": "kasi-digital-hub"
}
