{
    "name": "HubOps",
    "slug": "hub-ops",
    "title": "KasiHub Ops",
    "description": "Hub setup, check-in, facilitator assisted mode, events, bookings, hub finance",
    "group": "operations",
    "release": "r1",
    "version": "0.7.0",
    "depends_on": [
        "Core"
    ],
    "providers": [
        "Modules\\HubOps\\Providers\\HubOpsServiceProvider"
    ],
    "routes": {
        "web": true,
        "api": false
    },
    "entitlement": "hub_ops",
    "roles": [
        {
            "key": "hub_owner",
            "label": "Hub owner",
            "category": "hub",
            "scope": "hub",
            "staff": true,
            "access": {
                "Work": "view",
                "Learn": "view",
                "Start": "view",
                "Connect": "view",
                "HubOps": "manage",
                "Funder": "view"
            },
            "permissions": [
                "hubops.*"
            ]
        },
        {
            "key": "hub_manager",
            "label": "Hub manager",
            "category": "hub",
            "scope": "hub",
            "staff": true,
            "access": {
                "Work": "assist",
                "Learn": "assist",
                "Start": "assist",
                "Connect": "assist",
                "HubOps": "manage",
                "Funder": "view"
            },
            "permissions": [
                "hubops.*"
            ]
        },
        {
            "key": "hub_facilitator",
            "label": "Hub facilitator",
            "category": "hub",
            "scope": "hub",
            "staff": true,
            "access": {
                "Work": "assist",
                "Learn": "assist",
                "Start": "assist",
                "Connect": "assist",
                "HubOps": "use"
            },
            "permissions": [
                "hubops.dashboard",
                "hubops.checkin",
                "hubops.members",
                "hubops.assist",
                "hubops.events"
            ]
        }
    ],
    "permissions": [
        "hubops.dashboard",
        "hubops.compare",
        "hubops.checkin",
        "hubops.members",
        "hubops.assist",
        "hubops.events",
        "hubops.events.cancel",
        "hubops.settings"
    ],
    "events": {
        "publishes": [
            "hubops.visit.recorded",
            "hubops.event.scheduled",
            "hubops.event.cancelled",
            "hubops.event.attended",
            "hubops.assisted.registration"
        ],
        "consumes": []
    },
    "impact_metrics": [
        "hub_visits",
        "events_held"
    ],
    "demo_seeders": [
        "Modules\\HubOps\\Database\\Seeders\\DemoHubOpsSeeder"
    ],
    "nav": {
        "icon": "building",
        "href": "/hub-ops",
        "items": [
            {
                "label": "nav.hubops.dashboard",
                "href": "/hub-ops",
                "icon": "bar-chart",
                "permission": "hubops.dashboard"
            },
            {
                "label": "nav.hubops.check_in",
                "href": "/hub-ops/check-in",
                "icon": "qr",
                "permission": "hubops.checkin"
            },
            {
                "label": "nav.hubops.members",
                "href": "/hub-ops/members",
                "icon": "users",
                "permission": "hubops.members"
            },
            {
                "label": "nav.hubops.events",
                "href": "/hub-ops/events",
                "icon": "calendar",
                "permission": "hubops.events"
            },
            {
                "label": "nav.hubops.compare",
                "href": "/hub-ops/compare",
                "icon": "clipboard",
                "permission": "hubops.compare"
            },
            {
                "label": "nav.hubops.settings",
                "href": "/hub-ops/settings",
                "icon": "settings",
                "permission": "hubops.settings"
            }
        ]
    }
}
