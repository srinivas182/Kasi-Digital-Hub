{
    "name": "Learn",
    "slug": "learn",
    "title": "KasiLearn",
    "description": "Learning and skills: courses, assessments, certificates, cohorts, AI tutor",
    "group": "service",
    "release": "r1",
    "version": "0.14.0",
    "depends_on": [
        "Core"
    ],
    "providers": [
        "Modules\\Learn\\Providers\\LearnServiceProvider"
    ],
    "routes": {
        "web": true,
        "api": false
    },
    "entitlement": "learn",
    "roles": [
        {
            "key": "learner",
            "label": "Learner",
            "category": "individual",
            "scope": "self",
            "staff": false,
            "access": {
                "Learn": "use"
            },
            "permissions": [
                "learn.study"
            ]
        },
        {
            "key": "provider_admin",
            "label": "Training provider admin",
            "category": "organisation",
            "scope": "organisation",
            "staff": true,
            "access": {
                "Learn": "manage"
            },
            "permissions": [
                "learn.provide",
                "learn.approve"
            ]
        },
        {
            "key": "course_author",
            "label": "Course author",
            "category": "organisation",
            "scope": "organisation",
            "staff": true,
            "access": {
                "Learn": "use"
            },
            "permissions": [
                "learn.provide"
            ]
        },
        {
            "key": "assessor_moderator",
            "label": "Assessor / moderator",
            "category": "organisation",
            "scope": "organisation",
            "staff": true,
            "access": {
                "Learn": "use"
            },
            "permissions": [
                "learn.assess"
            ]
        }
    ],
    "permissions": [
        "learn.study",
        "learn.provide",
        "learn.approve",
        "learn.assess",
        "learn.review"
    ],
    "events": {
        "publishes": [
            "learn.course.submitted",
            "learn.course.published",
            "learn.course.unpublished",
            "learn.provider.registered",
            "learn.enrolled",
            "learn.lesson.completed",
            "learn.quiz.passed",
            "learn.assignment.assessed",
            "learn.course.completed"
        ],
        "consumes": []
    },
    "impact_metrics": [
        "enrolments",
        "completions",
        "certificates"
    ],
    "demo_seeders": [
        "Modules\\Learn\\Database\\Seeders\\DemoLearnSeeder"
    ],
    "nav": {
        "icon": "book-open",
        "href": "/learn/courses",
        "items": [
            {
                "label": "nav.learn.my_courses",
                "href": "/learn/my",
                "icon": "book-open"
            },
            {
                "label": "nav.learn.catalogue",
                "href": "/learn/courses",
                "icon": "grid"
            },
            {
                "label": "nav.learn.author",
                "href": "/learn/author",
                "icon": "book-open",
                "permission": "learn.provide"
            },
            {
                "label": "nav.learn.review",
                "href": "/learn/review",
                "icon": "shield",
                "permission": "learn.review"
            },
            {
                "label": "nav.learn.assess",
                "href": "/learn/assess",
                "icon": "shield",
                "permission": "learn.assess"
            }
        ]
    }
}
