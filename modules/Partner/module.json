{
    "name": "Partner",
    "slug": "partner",
    "title": "Partner portal",
    "description": "Banks, insurers, funding agencies and corporate buyers: referrals and offers",
    "group": "operations",
    "release": "r1",
    "version": "0.17.0",
    "depends_on": [
        "Core"
    ],
    "providers": [
        "Modules\\Partner\\Providers\\PartnerServiceProvider"
    ],
    "routes": {
        "web": true,
        "api": false
    },
    "entitlement": null,
    "roles": [
        {
            "key": "partner_admin",
            "label": "Partner admin",
            "category": "organisation",
            "scope": "organisation",
            "staff": true,
            "access": {
                "Start": "view",
                "Connect": "view",
                "Partner": "manage"
            },
            "permissions": [
                "partner.portal"
            ]
        },
        {
            "key": "partner_agent",
            "label": "Partner agent",
            "category": "organisation",
            "scope": "organisation",
            "staff": true,
            "access": {
                "Partner": "use"
            },
            "permissions": [
                "partner.portal"
            ]
        }
    ],
    "permissions": [
        "partner.portal"
    ],
    "events": {
        "publishes": [
            "partner.referral.sent",
            "partner.referral.stage_changed",
            "partner.support.confirmed",
            "partner.followup.answered"
        ],
        "listens": [
            "core.moderation.decided"
        ]
    },
    "impact_metrics": [],
    "demo_seeders": [
        "Modules\\Partner\\Database\\Seeders\\DemoPartnerSeeder"
    ],
    "nav": {
        "icon": "store",
        "href": "/partner",
        "items": [
            {
                "label": "nav.partner.referrals",
                "href": "/partner",
                "icon": "store",
                "permission": "partner.portal"
            }
        ]
    }
}
