                "icon": "palette"
            },
            {
                "label": "nav.brand.kit",
                "href": "/brand/kit",
                "icon": "settings"
            },
            {
                "label": "nav.brand.designs",
                "href": "/brand/designs",
                "icon": "grid"
            },
            {
                "label": "nav.brand.catalogue",
                "href": "/brand/catalogue",
                "icon": "store"
            },
            {
                "label": "nav.brand.site",
                "href": "/brand/site",
                "icon": "globe"
            },
            {
                "label": "nav.brand.calendar",
                "href": "/brand/calendar",
                "icon": "calendar"
