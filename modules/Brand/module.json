{
    "name": "Brand",
    "slug": "brand",
    "title": "KasiBrand",
    "description": "Brand kit, designs and a WhatsApp catalogue for small businesses",
    "group": "service",
    "release": "r1",
    "version": "0.30.0",
    "depends_on": [
        "Core",
        "Start"
    ],
    "providers": [
        "Modules\\Brand\\Providers\\BrandServiceProvider"
    ],
    "routes": {
        "web": true,
        "api": false
    },
    "entitlement": "brand",
    "roles": [],
    "permissions": [],
