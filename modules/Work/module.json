{
    "name": "Work",
    "slug": "work",
    "title": "KasiWork",
    "description": "Jobs and AI matching: AI CVs, 0-10 matching, employers, hiring pipeline",
    "group": "service",
    "release": "r1",
    "version": "0.9.0",
    "depends_on": [
        "Core"
    ],
    "providers": [
        "Modules\\Work\\Providers\\WorkServiceProvider"
    ],
    "routes": {
        "web": true,
        "api": false
    },
    "entitlement": "work",
    "roles": [
        {
            "key": "job_seeker",
            "label": "Job seeker",
            "category": "individual",
            "scope": "self",
            "staff": false,
            "access": {
                "Work": "use",
                "Learn": "use"
            }
        },
        {
            "key": "employer_admin",
            "label": "Employer admin",
            "category": "organisation",
            "scope": "organisation",
            "staff": true,
            "access": {
                "Work": "manage",
                "Learn": "use",
                "Connect": "use"
            }
        },
        {
            "key": "recruiter",
            "label": "Recruiter",
            "category": "organisation",
            "scope": "organisation",
            "staff": true,
            "access": {
                "Work": "use"
            }
        }
    ],
    "permissions": [],
    "events": {
        "publishes": [
            "work.profile.completed",
            "work.cv.created"
        ],
        "consumes": []
    },
    "impact_metrics": [
        "cvs_completed",
        "applications",
        "hires"
    ],
    "demo_seeders": [
        "Modules\\Work\\Database\\Seeders\\DemoWorkSeeder"
    ],
    "nav": {
        "icon": "briefcase",
        "href": "/work/profile",
        "items": [
            {
                "label": "nav.work.profile",
                "href": "/work/profile",
                "icon": "users"
            },
            {
                "label": "nav.work.cv",
                "href": "/work/cv",
                "icon": "book-open"
            }
        ]
    }
}
